<ManualScreen>:
    name: "manual"
    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            type: "small"

            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "arrow-left"
                    on_release: app.change_screen("home")

            MDTopAppBarTitle:
                text: app.i18n.current_lang and app._("manual_title")
                halign: "center"

            MDTopAppBarTrailingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "translate"
                    on_release: app.toggle_language()

        MDBoxLayout:
            orientation: "horizontal"
            padding: "24dp"
            spacing: "24dp"

            # ---------- 左：直线轴 ----------
            MDCard:
                orientation: "vertical"
                padding: "24dp"
                size_hint_x: 0.5
                radius: [16, 16, 16, 16]
                md_bg_color: 0.17, 0.19, 0.21, 1

                MDLabel:
                    text: app.i18n.current_lang and app._("manual_linear_axes")
                    theme_text_color: "Secondary"

                Widget:
                    size_hint_y: 0.03

                MDLabel:
                    text: app.i18n.current_lang and app._("manual_step_mm")
                    theme_text_color: "Secondary"
                    size_hint_y: None
                    height: dp(24)

                MDBoxLayout:
                    orientation: "horizontal"
                    spacing: "8dp"
                    size_hint_y: None
                    height: dp(40)

                    MDSlider:
                        id: linear_step_slider
                        min: 1
                        max: 100
                        value: 5
                        step: 1
                        on_value: root.on_linear_step_slider(self.value / 10)

                    MDLabel:
                        id: linear_step_label
                        text: "{:0.1f} {}".format(root.linear_step_mm, app._('common_unit_mm') if app.lang else "")
                        theme_text_color: "Secondary"
                        size_hint_x: None
                        width: dp(80)

                Widget:
                    size_hint_y: 0.05

                # ---- 外径滑台 ----
                MDLabel:
                    text: app.i18n.current_lang and app._("manual_od_slide")
                    theme_text_color: "Secondary"

                MDBoxLayout:
                    orientation: "horizontal"
                    spacing: "8dp"
                    size_hint_y: None
                    height: dp(40)

                    MDRaisedButton:
                        text: app.i18n.current_lang and app._("manual_button_od_neg")
                        on_release: root.jog_od_neg()

                    MDRaisedButton:
                        text: app.i18n.current_lang and app._("manual_button_od_pos")
                        on_release: root.jog_od_pos()

                    MDRaisedButton:
                        text: app.i18n.current_lang and app._("manual_button_home")
                        on_release: root.home_od()

                    MDLabel:
                        id: od_pos_label
                        text: "0.0 {}".format(app._('common_unit_mm') if app.lang else "")
                        theme_text_color: "Custom"
                        halign: "right"

                Widget:
                    size_hint_y: 0.02

                # ---- 内径滑台 ----
                MDLabel:
                    text: app.i18n.current_lang and app._("manual_id_slide")
                    theme_text_color: "Secondary"

                MDBoxLayout:
                    orientation: "horizontal"
                    spacing: "8dp"
                    size_hint_y: None
                    height: dp(40)

                    MDRaisedButton:
                        text: app.i18n.current_lang and app._("manual_button_id_neg")
                        on_release: root.jog_id_neg()

                    MDRaisedButton:
                        text: app.i18n.current_lang and app._("manual_button_id_pos")
                        on_release: root.jog_id_pos()

                    MDRaisedButton:
                        text: app.i18n.current_lang and app._("manual_button_home")
                        on_release: root.home_id()

                    MDLabel:
                        id: id_pos_label
                        text: "0.0 {}".format(app._('common_unit_mm') if app.lang else "")
                        theme_text_color: "Custom"
                        halign: "right"

                Widget:
                    size_hint_y: 0.02

                # ---- 内径测头伸缩 ----
                MDLabel:
                    text: app.i18n.current_lang and app._("manual_id_head_extend")
                    theme_text_color: "Secondary"

                MDBoxLayout:
                    orientation: "horizontal"
                    spacing: "8dp"
                    size_hint_y: None
                    height: dp(40)

                    MDRaisedButton:
                        text: app.i18n.current_lang and app._("manual_button_in")
                        on_release: root.jog_head_in()

                    MDRaisedButton:
                        text: app.i18n.current_lang and app._("manual_button_out")
                        on_release: root.jog_head_out()

                    MDRaisedButton:
                        text: app.i18n.current_lang and app._("manual_button_home")
                        on_release: root.home_head()

                    MDLabel:
                        id: head_pos_label
                        text: "0.0 {}".format(app._('common_unit_mm') if app.lang else "")
                        theme_text_color: "Custom"
                        halign: "right"

            # ---------- 右：旋转轴 ----------
            MDCard:
                orientation: "vertical"
                padding: "24dp"
                size_hint_x: 0.5
                radius: [16, 16, 16, 16]
                md_bg_color: 0.17, 0.19, 0.21, 1

                MDLabel:
                    text: app.i18n.current_lang and app._("manual_rotary_axes")
                    theme_text_color: "Secondary"

                Widget:
                    size_hint_y: 0.03

                MDLabel:
                    text: app.i18n.current_lang and app._("manual_step_deg")
                    theme_text_color: "Secondary"
                    size_hint_y: None
                    height: dp(24)

                MDBoxLayout:
                    orientation: "horizontal"
                    spacing: "8dp"
                    size_hint_y: None
                    height: dp(40)

                    MDSlider:
                        id: rot_step_slider
                        min: 1
                        max: 90
                        value: 5
                        step: 1
                        on_value: root.on_rot_step_slider(self.value)

                    MDLabel:
                        id: rot_step_label
                        text: "{:0.1f} {}".format(root.rotary_step_deg, app._('common_unit_deg') if app.lang else "")
                        theme_text_color: "Secondary"
                        size_hint_x: None
                        width: dp(80)

                Widget:
                    size_hint_y: 0.05

                # ---- 主旋转电机 ----
                MDLabel:
                    text: app.i18n.current_lang and app._("manual_main_pipe_rotate")
                    theme_text_color: "Secondary"

                MDBoxLayout:
                    orientation: "horizontal"
                    spacing: "8dp"
                    size_hint_y: None
                    height: dp(40)

                    MDRaisedButton:
                        text: app.i18n.current_lang and app._("manual_button_ccw")
                        on_release: root.jog_main_ccw()

                    MDRaisedButton:
                        text: app.i18n.current_lang and app._("manual_button_cw")
                        on_release: root.jog_main_cw()

                    MDRaisedButton:
                        text: app.i18n.current_lang and app._("manual_button_home")
                        on_release: root.home_main_rot()

                    MDLabel:
                        id: main_angle_label
                        text: "0.0 {}".format(app._('common_unit_deg') if app.lang else "")
                        theme_text_color: "Custom"
                        halign: "right"

                Widget:
                    size_hint_y: 0.02

                # ---- 从旋转电机 ----
                MDLabel:
                    text: app.i18n.current_lang and app._("manual_aux_rotate")
                    theme_text_color: "Secondary"

                MDBoxLayout:
                    orientation: "horizontal"
                    spacing: "8dp"
                    size_hint_y: None
                    height: dp(40)

                    MDRaisedButton:
                        text: app.i18n.current_lang and app._("manual_button_ccw")
                        on_release: root.jog_aux_ccw()

                    MDRaisedButton:
                        text: app.i18n.current_lang and app._("manual_button_cw")
                        on_release: root.jog_aux_cw()

                    MDRaisedButton:
                        text: app.i18n.current_lang and app._("manual_button_home")
                        on_release: root.home_aux_rot()

                    MDLabel:
                        id: aux_angle_label
                        text: "0.0 {}".format(app._('common_unit_deg') if app.lang else "")
                        theme_text_color: "Custom"
                        halign: "right"


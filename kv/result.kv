<ResultScreen>:
    name: "result"
    MDBoxLayout:
        orientation: "vertical"
        padding: dp(16)
        spacing: dp(16)

        MDTopAppBar:
            type: "small"

            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "arrow-left"
                    on_release: app.change_screen("home")

            MDTopAppBarTitle:
                text: app.i18n.current_lang and app._("result_title")
                halign: "center"

            MDTopAppBarTrailingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "translate"
                    on_release: app.toggle_language()

        MDBoxLayout:
            orientation: "vertical"
            spacing: dp(12)

            # 表格区域
            MDCard:
                orientation: "vertical"
                padding: dp(8)
                radius: dp(12)
                md_bg_color: 0.08, 0.08, 0.08, 1
                MDLabel:
                    text: app.i18n.current_lang and app._("result_report_title")
                    theme_text_color: "Secondary"
                    padding_y: dp(4)
                MDSeparator:
                MDBoxLayout:
                    id: result_table_container
                    orientation: "vertical"

            # 下面可以保留简单的结果总结
            MDBoxLayout:
                size_hint_y: None
                height: dp(40)
                spacing: dp(12)

                MDLabel:
                    id: res_ok_label
                    text: app.i18n.current_lang and app._("common_ok")
                    theme_text_color: "Custom"
                    text_color: (0, 1, 0, 1)

                Widget:

<StatusChip@BoxLayout>:
    status: "pending"          # "ok" / "ng" / 其他
    size_hint: None, None
    height: "22dp"
    width: "56dp"              # 稍微加宽一点，避免再被压得太紧
    padding: [10, 2, 10, 2]
    spacing: 0

    canvas.before:
        Color:
            rgba:
                (0, 0.7, 0, 1) if root.status == "ok" else \
                ((1, 0.25, 0.25, 1) if root.status == "ng" else (0.5, 0.5, 0.5, 1))
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [11, 11, 11, 11]

    Label:
        text:
            app.i18n.current_lang and (
            app._("common_ok") if root.status == "ok" else
            (app._("common_ng") if root.status == "ng" else app._("common_unknown"))
            )
        font_size: "13sp"
        bold: True
        color: 1, 1, 1, 1
        halign: "center"
        valign: "middle"

<ResultCard@MDCard>:
    title: ""
    current_value: ""
    standard_value: ""
    tolerance: ""
    unit: ""
    status: "pending"      # "ok" / "ng" / 其他

    size_hint_y: None
    height: "180dp"
    padding: 0
    radius: [16, 16, 16, 16]
    elevation: 0
    md_bg_color: 0.08, 0.08, 0.08, 1

    canvas.after:
        Color:
            rgba: 0.35, 0.35, 0.35, 1
        Line:
            width: 1
            rounded_rectangle: (self.x, self.y, self.width, self.height, 16)

    BoxLayout:
        orientation: "vertical"
        padding: [16, 10, 16, 10]
        spacing: "6dp"

        # 顶部：标题 + 状态胶囊
        BoxLayout:
            size_hint_y: None
            height: "26dp"

            Label:
                text: root.title
                font_size: "15sp"
                bold: True
                halign: "left"
                valign: "middle"

            Widget:
                size_hint_x: 1

            StatusChip:
                status: root.status

        # 中部：大数字 + 单位（整体居中）
        BoxLayout:
            size_hint_y: None
            height: "96dp"

            AnchorLayout:
                anchor_x: "center"
                anchor_y: "center"

                BoxLayout:
                    orientation: "horizontal"
                    size_hint: None, None
                    height: self.minimum_height
                    width: self.minimum_width
                    spacing: "4dp"

                    Label:
                        text: root.current_value
                        font_size: "34sp"
                        bold: True
                        halign: "center"
                        valign: "middle"
                        size_hint: None, None
                        texture_size: self.texture_size
                        width: self.texture_size[0]
                        height: self.texture_size[1]

                    Label:
                        text: root.unit
                        font_size: "16sp"
                        halign: "left"
                        valign: "middle"
                        size_hint: None, None
                        texture_size: self.texture_size
                        width: self.texture_size[0]
                        height: self.texture_size[1]

        # 底部：Std / Tol，小字行左右对齐
        BoxLayout:
            size_hint_y: None
            height: "26dp"
            spacing: "12dp"

            Label:
                text: (app._("common_std_prefix") if app.i18n.current_lang else "") + root.standard_value
                font_size: "12sp"
                halign: "left"
                valign: "middle"

            Widget:
                size_hint_x: 1

            Label:
                text: (app._("common_tol_prefix") if app.i18n.current_lang else "") + root.tolerance
                font_size: "12sp"
                halign: "right"
                valign: "middle"

<DoubleMetricCard@MDCard>:
    title: ""              # 卡片标题，例："Outer Diameter"
    main_value: ""         # 主指标数值
    main_unit: ""          # 主指标单位
    main_status: "pending" # 主指标状态
    sub_label: ""          # 次指标名称
    sub_value: ""          # 次指标数值
    sub_unit: ""           # 次指标单位
    sub_status: "pending"  # 次指标状态
    size_hint_y: None
    height: "200dp"
    padding: 0
    radius: [16, 16, 16, 16]
    elevation: 0
    md_bg_color: 0.08, 0.08, 0.08, 1

    canvas.after:
        Color:
            rgba: 0.35, 0.35, 0.35, 1
        Line:
            width: 1
            rounded_rectangle: (self.x, self.y, self.width, self.height, 16)

    BoxLayout:
        orientation: "vertical"
        padding: [16, 10, 16, 10]
        spacing: "6dp"

        # 顶部：标题 + 主状态
        BoxLayout:
            size_hint_y: None
            height: "26dp"

            Label:
                text: root.title
                font_size: "15sp"
                bold: True
                halign: "left"
                valign: "middle"

            Widget:
                size_hint_x: 1

            StatusChip:
                status: root.main_status

        # 中部：主指标大数字
        BoxLayout:
            size_hint_y: None
            height: "100dp"

            AnchorLayout:
                anchor_x: "center"
                anchor_y: "center"

                BoxLayout:
                    orientation: "horizontal"
                    size_hint: None, None
                    height: self.minimum_height
                    width: self.minimum_width
                    spacing: "4dp"

                    Label:
                        text: root.main_value
                        font_size: "34sp"
                        bold: True
                        halign: "center"
                        valign: "middle"
                        size_hint: None, None
                        texture_size: self.texture_size
                        width: self.texture_size[0]
                        height: self.texture_size[1]

                    Label:
                        text: root.main_unit
                        font_size: "16sp"
                        halign: "left"
                        valign: "middle"
                        size_hint: None, None
                        texture_size: self.texture_size
                        width: self.texture_size[0]
                        height: self.texture_size[1]

        # 底部：次指标 + 状态
        BoxLayout:
            size_hint_y: None
            height: "26dp"
            spacing: "8dp"

            Label:
                text: "{}: {}{}".format(root.sub_label, root.sub_value, root.sub_unit)
                font_size: "12sp"
                halign: "left"
                valign: "middle"

            Widget:
                size_hint_x: 1

            StatusChip:
                status: root.sub_status

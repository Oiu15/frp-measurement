<HomeScreen>:
    name: "home"
    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            type: "small"

            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "menu"
                    on_release: app.open_drawer() if hasattr(app, "open_drawer") else None

            MDTopAppBarTitle:
                text: "FRP Pipe - Home"
                halign: "center"

            MDTopAppBarTrailingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "wrench-cog"
                    on_release: app.change_screen("manual")

                MDActionTopAppBarButton:
                    icon: "cog"
                    on_release: app.change_screen("settings")

        MDBoxLayout:
            orientation: "vertical"
            padding: "16dp"
            spacing: "16dp"

            MDBoxLayout:
                orientation: "horizontal"
                spacing: "16dp"
                size_hint_y: 12

                MDCard:
                    orientation: "vertical"
                    padding: "8dp"
                    size_hint_x: 30
                    MDBoxLayout:
                        orientation: "vertical"
                        padding: "8dp"
                        spacing: "8dp"

                        # 上排：外径组 + 内径组
                        MDBoxLayout:
                            size_hint_y: None
                            height: "200dp"
                            spacing: "8dp"

                            DoubleMetricCard:
                                title: "Outer Diameter"
                                main_value: "219.998"
                                main_unit: "mm"
                                main_status: "ok"
                                sub_label: "Roundness"
                                sub_value: "0.008"
                                sub_unit: "mm"
                                sub_status: "ok"

                            DoubleMetricCard:
                                title: "Inner Diameter"
                                main_value: "152.695"
                                main_unit: "mm"
                                main_status: "ng"
                                sub_label: "Roundness"
                                sub_value: "0.012"
                                sub_unit: "mm"
                                sub_status: "ng"

                        # 下排：长度 / 直线度 / 同心度
                        MDBoxLayout:
                            size_hint_y: None
                            height: "180dp"
                            spacing: "8dp"

                            ResultCard:
                                title: "Length"
                                current_value: "1802.3"
                                unit: "mm"
                                status: "ok"
                                standard_value: "1800.0"
                                tolerance: "±5.0"

                            ResultCard:
                                title: "Straightness"
                                current_value: "0.021"
                                unit: "mm"
                                status: "ok"
                                standard_value: "≤0.050"
                                tolerance: "—"

                            ResultCard:
                                title: "Concentricity"
                                current_value: "0.012"
                                unit: "mm"
                                status: "ng"
                                standard_value: "≤0.010"
                                tolerance: "—"

                MDCard:
                    orientation: "vertical"
                    size_hint_x: 8
                    md_bg_color: 0.17, 0.19, 0.21, 1
                    radius: [16, 16, 16, 16]
                    padding: [12, 12, 12, 12]

                    # 卡片内部标题
                    MDLabel:
                        text: "Peripheral Status"
                        halign: "center"
                        size_hint_y: None
                        height: "24dp"

                    MDSeparator:

                    # 真正装状态行的容器
                    MDBoxLayout:
                        orientation: "vertical"
                        padding: [0, 8, 0, 8]   # 这里控制第一行离标题/分隔线的距离
                        spacing: "10dp"

                        PeripheralStatusRow:
                            text: "Rotary Servo"
                        PeripheralStatusRow:
                            text: "OD Slide"
                        PeripheralStatusRow:
                            text: "ID Slide"
                        PeripheralStatusRow:
                            text: "OD Sensor"
                        PeripheralStatusRow:
                            text: "ID Sensor"
                        PeripheralStatusRow:
                            text: "PLC"
                        PeripheralStatusRow:
                            text: "Core DLL"

            MDBoxLayout:
                orientation: "horizontal"
                spacing: "16dp"
                size_hint_y: 8

                MDCard:
                    orientation: "vertical"
                    padding: "16dp"
                    size_hint_x: 35
                    StatusInfoCard:
                        id: status_info_card
                        size_hint_x: 1

                MDCard:
                    orientation: "vertical"
                    padding: "16dp"
                    size_hint_x: 15
                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: "16dp"

                        MDBoxLayout:
                            orientation: "vertical"
                            spacing: "10dp"
                            size_hint_x: 0.6
                            MDLabel:
                                id: current_step_label
                                text: "Current Step: 1"
                                halign: "left"
                                theme_text_color: "Primary"
                            MDLabel:
                                id: next_step_label
                                text: "Next Step: 2"
                                halign: "left"
                                theme_text_color: "Secondary"

                        MDButton:
                            id: state_button
                            style: "elevated"
                            size_hint: None, None
                            size: "120dp", "64dp"
                            theme_bg_color: "Custom"
                            md_bg_color: 0.2, 0.6, 0.9, 1
                            on_release: root.on_state_button_pressed()

                            MDButtonText:
                                id: state_button_text
                                text: "Start"
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1



<HomeScreen>:
    name: "home"
    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            type: "small"

            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "menu"
                    on_release: app.open_drawer() if hasattr(app, "open_drawer") else None

            MDTopAppBarTitle:
                text: "FRP Pipe - Home"
                halign: "center"

            MDTopAppBarTrailingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "wrench-cog"
                    on_release: app.change_screen("manual")

                MDActionTopAppBarButton:
                    icon: "cog"
                    on_release: app.change_screen("settings")

        MDBoxLayout:
            orientation: "vertical"
            padding: "16dp"
            spacing: "16dp"

            MDBoxLayout:
                orientation: "horizontal"
                spacing: "16dp"
                size_hint_y: 0.5

                MDCard:
                    orientation: "vertical"
                    padding: "16dp"
                    size_hint_x: 0.5
                    MDGridLayout:
                        cols: 3
                        rows: 2
                        spacing: "12dp"
                        adaptive_height: True
                        adaptive_width: True
                        size_hint: 1, 1

                        ResultCard:
                            title: "Length"
                            value: "123.4"
                            unit: "mm"
                        ResultCard:
                            title: "OD"
                            value: "100.0"
                            unit: "mm"
                        ResultCard:
                            title: "ID"
                            value: "95.0"
                            unit: "mm"
                        ResultCard:
                            title: "Roundness"
                            value: "0.20"
                            unit: "mm"
                        ResultCard:
                            title: "Straightness"
                            value: "0.15"
                            unit: "mm/m"
                        ResultCard:
                            title: "Concentricity"
                            value: "0.10"
                            unit: "mm"

                MDCard:
                    orientation: "vertical"
                    size_hint_x: 0.5
                    md_bg_color: 0.17, 0.19, 0.21, 1
                    radius: [16, 16, 16, 16]
                    padding: [12, 12, 12, 12]

                    # 卡片内部标题
                    MDLabel:
                        text: "Peripheral Status"
                        halign: "center"
                        size_hint_y: None
                        height: "24dp"

                    MDSeparator:

                    # 真正装状态行的容器
                    MDBoxLayout:
                        orientation: "vertical"
                        padding: [0, 8, 0, 8]   # 这里控制第一行离标题/分隔线的距离
                        spacing: "10dp"

                        PeripheralStatusRow:
                            text: "Rotary Servo"
                        PeripheralStatusRow:
                            text: "OD Slide"
                        PeripheralStatusRow:
                            text: "ID Slide"
                        PeripheralStatusRow:
                            text: "OD Sensor"
                        PeripheralStatusRow:
                            text: "ID Sensor"
                        PeripheralStatusRow:
                            text: "PLC"
                        PeripheralStatusRow:
                            text: "Core DLL"

            MDBoxLayout:
                orientation: "horizontal"
                spacing: "16dp"
                size_hint_y: 0.5

                MDCard:
                    orientation: "vertical"
                    padding: "16dp"
                    size_hint_x: 0.5
                    MDLabel:
                        text: "Runtime Info"
                        halign: "center"
                        valign: "center"

                MDCard:
                    orientation: "vertical"
                    padding: "16dp"
                    size_hint_x: 0.5
                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: "12dp"
                        MDLabel:
                            text: "Process Info"
                            halign: "center"
                        MDLabel:
                            text: "Status Button"
                            halign: "center"
                        MDFloatingActionButton:
                            icon: "power"
                            md_bg_color: "#607d8b"
                            size: "84dp", "84dp"
                            elevation_normal: 8
                            pos_hint: {"center_x": 0.5}

<HomeScreen>:
    name: "home"
    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            type: "small"

            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "menu"
                    on_release: app.open_drawer() if hasattr(app, "open_drawer") else None

            MDTopAppBarTitle:
                text: "FRP Pipe - Home"
                halign: "center"

            MDTopAppBarTrailingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "wrench-cog"
                    on_release: app.change_screen("manual")

                MDActionTopAppBarButton:
                    icon: "cog"
                    on_release: app.change_screen("settings")

        MDBoxLayout:
            orientation: "vertical"
            padding: "16dp"
            spacing: "16dp"

            MDBoxLayout:
                orientation: "horizontal"
                spacing: "16dp"
                size_hint_y: 12

                MDCard:
                    orientation: "vertical"
                    padding: "16dp"
                    size_hint_x: 30
                    MDGridLayout:
                        cols: 3
                        rows: 2
                        spacing: "12dp"
                        adaptive_height: True
                        adaptive_width: True
                        size_hint: 1, 1

                        ResultCard:
                            id: length_card
                            title: "Length"
                            value: "123.4"
                            unit: "mm"
                        ResultCard:
                            id: od_card
                            title: "OD"
                            value: "100.0"
                            unit: "mm"
                        ResultCard:
                            id: id_card
                            title: "ID"
                            value: "95.0"
                            unit: "mm"
                        ResultCard:
                            id: roundness_card
                            title: "Roundness"
                            value: "0.20"
                            unit: "mm"
                        ResultCard:
                            id: straightness_card
                            title: "Straightness"
                            value: "0.15"
                            unit: "mm/m"
                        ResultCard:
                            id: concentricity_card
                            title: "Concentricity"
                            value: "0.10"
                            unit: "mm"

                MDCard:
                    orientation: "vertical"
                    size_hint_x: 8
                    md_bg_color: 0.17, 0.19, 0.21, 1
                    radius: [16, 16, 16, 16]
                    padding: [12, 12, 12, 12]

                    # 卡片内部标题
                    MDLabel:
                        text: "Peripheral Status"
                        halign: "center"
                        size_hint_y: None
                        height: "24dp"

                    MDSeparator:

                    # 真正装状态行的容器
                    MDBoxLayout:
                        orientation: "vertical"
                        padding: [0, 8, 0, 8]   # 这里控制第一行离标题/分隔线的距离
                        spacing: "10dp"

                        PeripheralStatusRow:
                            text: "Rotary Servo"
                        PeripheralStatusRow:
                            text: "OD Slide"
                        PeripheralStatusRow:
                            text: "ID Slide"
                        PeripheralStatusRow:
                            text: "OD Sensor"
                        PeripheralStatusRow:
                            text: "ID Sensor"
                        PeripheralStatusRow:
                            text: "PLC"
                        PeripheralStatusRow:
                            text: "Core DLL"

            MDBoxLayout:
                orientation: "horizontal"
                spacing: "16dp"
                size_hint_y: 8

                MDCard:
                    orientation: "vertical"
                    padding: "16dp"
                    size_hint_x: 35
                    MDGridLayout:
                        cols: 2
                        rows: 3
                        spacing: "12dp"
                        row_default_height: "60dp"
                        InfoItem:
                            id: system_state_item
                            label: "System State"
                            value: "Ready"
                        InfoItem:
                            id: measurement_state_item
                            label: "Measurement State"
                            value: "Idle"
                        InfoItem:
                            id: runtime_item
                            label: "Runtime"
                            value: "00:10:00"
                        InfoItem:
                            id: current_recipe_item
                            label: "Current Recipe"
                            value: "Demo-01"
                        InfoItem:
                            id: part_count_item
                            label: "Part Count"
                            value: "12"
                        InfoItem:
                            id: ng_count_item
                            label: "NG Count"
                            value: "1"

                MDCard:
                    orientation: "vertical"
                    padding: "16dp"
                    size_hint_x: 15
                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: "16dp"

                        MDBoxLayout:
                            orientation: "vertical"
                            spacing: "10dp"
                            size_hint_x: 0.6
                            MDLabel:
                                id: current_step_label
                                text: "Current Step: 1"
                                halign: "left"
                                theme_text_color: "Primary"
                            MDLabel:
                                id: next_step_label
                                text: "Next Step: 2"
                                halign: "left"
                                theme_text_color: "Secondary"

                        MDButton:
                            id: state_button
                            style: "elevated"
                            size_hint: None, None
                            size: "120dp", "64dp"
                            theme_bg_color: "Custom"
                            md_bg_color: 0.2, 0.6, 0.9, 1
                            on_release: root.on_state_button_pressed()

                            MDButtonText:
                                id: state_button_text
                                text: "Start"
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1



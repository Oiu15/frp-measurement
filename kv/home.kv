<HomeScreen>:
    name: "home"
    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            type: "small"

            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "menu"
                    on_release: app.open_drawer() if hasattr(app, "open_drawer") else None

            MDTopAppBarTitle:
                text: app.i18n.current_lang and app._("home_title")
                halign: "center"

            MDTopAppBarTrailingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "wrench-cog"
                    on_release: app.change_screen("manual")

                MDActionTopAppBarButton:
                    icon: "cog"
                    on_release: app.change_screen("settings")

                MDActionTopAppBarButton:
                    icon: "translate"
                    on_release: app.toggle_language()

        MDBoxLayout:
            orientation: "vertical"
            padding: "16dp"
            spacing: "16dp"

            MDBoxLayout:
                orientation: "horizontal"
                spacing: "16dp"
                size_hint_y: 12

                MDCard:
                    orientation: "vertical"
                    padding: "8dp"
                    size_hint_x: 30
                    MDBoxLayout:
                        orientation: "vertical"
                        padding: "8dp"
                        spacing: "8dp"

                        # 上排：外径组 + 内径组
                        MDBoxLayout:
                            size_hint_y: None
                            height: "200dp"
                            spacing: "8dp"

                            DoubleMetricCard:
                                title: app._("home_card_outer_title") if app.lang else ""
                                main_value: "219.998"
                                main_unit: app._("common_unit_mm") if app.lang else ""
                                main_status: "ok"
                                sub_label: app._("home_roundness") if app.lang else ""
                                sub_value: "0.008"
                                sub_unit: app._("common_unit_mm") if app.lang else ""
                                sub_status: "ok"

                            DoubleMetricCard:
                                title: app._("home_card_inner_title") if app.lang else ""
                                main_value: "152.695"
                                main_unit: app._("common_unit_mm") if app.lang else ""
                                main_status: "ng"
                                sub_label: app._("home_roundness") if app.lang else ""
                                sub_value: "0.012"
                                sub_unit: app._("common_unit_mm") if app.lang else ""
                                sub_status: "ng"

                        # 下排：长度 / 直线度 / 同心度
                        MDBoxLayout:
                            size_hint_y: None
                            height: "180dp"
                            spacing: "8dp"

                            ResultCard:
                                title: app._("home_length") if app.lang else ""
                                current_value: "1802.3"
                                unit: app._("common_unit_mm") if app.lang else ""
                                status: "ok"
                                standard_value: "1800.0"
                                tolerance: "±5.0"

                            ResultCard:
                                title: app._("home_straightness") if app.lang else ""
                                current_value: "0.021"
                                unit: app._("common_unit_mm") if app.lang else ""
                                status: "ok"
                                standard_value: "0.050"
                                tolerance: "±0.050"

                            ResultCard:
                                title: app._("home_concentricity") if app.lang else ""
                                current_value: "0.012"
                                unit: app._("common_unit_mm") if app.lang else ""
                                status: "ng"
                                standard_value: "0.010"
                                tolerance: "±0.010"

                MDCard:
                    orientation: "vertical"
                    size_hint_x: 8
                    md_bg_color: 0.17, 0.19, 0.21, 1
                    radius: [16, 16, 16, 16]
                    padding: [12, 12, 12, 12]

                    # 卡片内部标题
                    MDLabel:
                        text: app.i18n.current_lang and app._("home_peripheral_status_title")
                        halign: "center"
                        size_hint_y: None
                        height: "24dp"

                    MDSeparator:

                    # 真正装状态行的容器
                    MDBoxLayout:
                        orientation: "vertical"
                        padding: [0, 8, 0, 8]   # 这里控制第一行离标题/分隔线的距离
                        spacing: "10dp"

                        PeripheralStatusRow:
                            text: app.i18n.current_lang and app._("home_peripheral_rotary_servo")
                        PeripheralStatusRow:
                            text: app.i18n.current_lang and app._("home_peripheral_od_slide")
                        PeripheralStatusRow:
                            text: app.i18n.current_lang and app._("home_peripheral_id_slide")
                        PeripheralStatusRow:
                            text: app.i18n.current_lang and app._("home_peripheral_od_sensor")
                        PeripheralStatusRow:
                            text: app.i18n.current_lang and app._("home_peripheral_id_sensor")
                        PeripheralStatusRow:
                            text: app.i18n.current_lang and app._("home_peripheral_plc")
                        PeripheralStatusRow:
                            text: app.i18n.current_lang and app._("home_peripheral_core_dll")

            MDBoxLayout:
                orientation: "horizontal"
                spacing: "16dp"
                size_hint_y: 8

                MDCard:
                    orientation: "vertical"
                    padding: "16dp"
                    size_hint_x: 35
                    StatusInfoCard:
                        id: status_info_card
                        size_hint_x: 1
 
                HomeActionCard:
                    id: home_action_card
                    orientation: "vertical"
                    padding: "16dp"
                    size_hint_x: 15
                    size_hint_y: None
                    height: "260dp"


<StatusInfoCard@MDBoxLayout>:
    orientation: "vertical"
    padding: "8dp"

    MDGridLayout:
        cols: 2
        adaptive_height: True
        spacing: "24dp"

        # ================= 左栏：系统 + 通讯 =================
        MDBoxLayout:
            orientation: "vertical"
            spacing: "4dp"
            adaptive_height: True

            # --- System ---
            MDLabel:
                text: app.i18n.current_lang and app._("status_system_title")
                font_style: "Title"
                role: "small"
                bold: True
                theme_text_color: "Secondary"
                size_hint_y: None
                height: self.texture_size[1]

            MDBoxLayout:
                adaptive_height: True
                MDLabel:
                    text: app.i18n.current_lang and app._("status_system_state")
                    theme_text_color: "Secondary"
                    size_hint_y: None
                    height: self.texture_size[1]
                MDLabel:
                    id: system_state_value
                    text: app.i18n.current_lang and app._("status_system_ready")
                    halign: "right"
                    size_hint_y: None
                    height: self.texture_size[1]

            MDBoxLayout:
                adaptive_height: True
                MDLabel:
                    text: app.i18n.current_lang and app._("status_mode")
                    theme_text_color: "Secondary"
                    size_hint_y: None
                    height: self.texture_size[1]
                MDLabel:
                    id: system_mode_value
                    text: app.i18n.current_lang and app._("status_mode_auto")
                    halign: "right"
                    size_hint_y: None
                    height: self.texture_size[1]

            MDBoxLayout:
                adaptive_height: True
                MDLabel:
                    text: app.i18n.current_lang and app._("status_runtime")
                    theme_text_color: "Secondary"
                    size_hint_y: None
                    height: self.texture_size[1]
                MDLabel:
                    id: system_runtime_value
                    text: "00:10:00"
                    halign: "right"
                    size_hint_y: None
                    height: self.texture_size[1]
            MDBoxLayout:
                adaptive_height: True
                MDLabel:
                    text: app.i18n.current_lang and app._("status_recipe")
                    theme_text_color: "Secondary"
                    size_hint_y: None
                    height: self.texture_size[1]
                MDLabel:
                    id: system_recipe_value
                    text: "Demo-01"
                    halign: "right"
                    shorten: True
                    shorten_from: "left"

            MDBoxLayout:
                adaptive_height: True
                MDLabel:
                    text: app.i18n.current_lang and app._("status_last_result")
                    theme_text_color: "Secondary"
                    size_hint_y: None
                    height: self.texture_size[1]
                MDLabel:
                    id: system_last_result_value
                    text: app._("common_ok") if app.lang else ""
                    halign: "right"
                    size_hint_y: None
                    height: self.texture_size[1]

            # 间隔一点，�?System �?Communication 视觉上分开
            Widget:
                size_hint_y: None
                height: "8dp"

            # --- Communication ---
            MDLabel:
                text: app.i18n.current_lang and app._("status_communication_title")
                font_style: "Title"
                role: "small"
                bold: True
                theme_text_color: "Secondary"
                size_hint_y: None
                height: self.texture_size[1]

            # 单行显示，将来可以加滚动效果的那一�?
            MDBoxLayout:
                size_hint_y: None
                height: "24dp"

                MDLabel:
                    id: comm_status_value
                    text: app.i18n.current_lang and app._("status_all_online")
                    # 正常时用主题颜色，错误时�?Python 里改成红�?
                    theme_text_color: "Custom"
                    text_color: app.theme_cls.primaryColor
                    halign: "left"
                    shorten: True        # 超出宽度时先�?shorten，之后再做滚动动�?
                    shorten_from: "right"

        # ================= 右栏：测�?=================
        MDBoxLayout:
            orientation: "vertical"
            spacing: "4dp"
            adaptive_height: True

            MDLabel:
                text: app.i18n.current_lang and app._("status_measurement_title")
                font_style: "Title"
                role: "small"
                bold: True
                theme_text_color: "Secondary"
                size_hint_y: None
                height: self.texture_size[1]

            MDBoxLayout:
                adaptive_height: True
                MDLabel:
                    text: app.i18n.current_lang and app._("status_state")
                    theme_text_color: "Secondary"
                    size_hint_y: None
                    height: self.texture_size[1]
                MDLabel:
                    id: meas_state_value
                    text: app.i18n.current_lang and app._("status_idle")
                    halign: "right"
                    size_hint_y: None
                    height: self.texture_size[1]

            MDBoxLayout:
                adaptive_height: True
                MDLabel:
                    text: app.i18n.current_lang and app._("status_current_step")
                    theme_text_color: "Secondary"
                    size_hint_y: None
                    height: self.texture_size[1]
                MDLabel:
                    id: meas_step_value
                    text: app.i18n.current_lang and app._("status_dash")
                    halign: "right"
                    shorten: True
                    shorten_from: "left"
                    size_hint_y: None
                    height: self.texture_size[1]

            MDBoxLayout:
                adaptive_height: True
                MDLabel:
                    text: app.i18n.current_lang and app._("status_last_time")
                    theme_text_color: "Secondary"
                    size_hint_y: None  
                    height: self.texture_size[1]
                MDLabel:
                    id: meas_last_time_value
                    text: "00:00"
                    halign: "right"
                    size_hint_y: None
                    height: self.texture_size[1]

            MDBoxLayout:
                adaptive_height: True
                MDLabel:
                    text: app.i18n.current_lang and app._("status_avg_time")
                    theme_text_color: "Secondary"
                    size_hint_y: None
                    height: self.texture_size[1]
                MDLabel:
                    id: meas_avg_time_value
                    text: "00:00"
                    halign: "right"
                    size_hint_y: None
                    height: self.texture_size[1]

            MDBoxLayout:
                adaptive_height: True
                MDLabel:
                    text: app.i18n.current_lang and app._("status_part_count")
                    theme_text_color: "Secondary"
                    size_hint_y: None
                    height: self.texture_size[1]
                MDLabel:
                    id: meas_part_count_value
                    text: "12"
                    halign: "right"
                    size_hint_y: None
                    height: self.texture_size[1]

            MDBoxLayout:
                adaptive_height: True
                MDLabel:
                    text: app.i18n.current_lang and app._("status_ng_count")
                    theme_text_color: "Secondary"
                    size_hint_y: None
                    height: self.texture_size[1]
                MDLabel:
                    id: meas_ng_count_value
                    text: "1"
                    halign: "right"
                    size_hint_y: None
                    height: self.texture_size[1]
            MDBoxLayout:
                adaptive_height: True
                MDLabel:
                    text: app.i18n.current_lang and app._("status_last_ng_reason")
                    theme_text_color: "Secondary"
                    size_hint_y: None
                    height: self.texture_size[1]
                MDLabel:
                    id: meas_last_ng_reason_value
                    text: app._("status_dash") if app.lang else ""
                    halign: "right"
                    shorten: True
                    shorten_from: "left"
                    size_hint_y: None
                    height: self.texture_size[1]

